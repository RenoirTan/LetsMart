{
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["dom", "dom.iterable", "es2022"],
    "allowJs": false,
    "skipLibCheck": true,
    "strict": true,
    "noEmit": true,
    "allowImportingTsExtensions": true,
    "esModuleInterop": true,
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "resolveJsonModule": true,
    "isolatedModules": true,
    "jsx": "preserve",
    "incremental": true,
    "baseUrl": ".",
    "paths": {
      "@sea-ops/schemas": ["packages/schemas/src"],
      "@sea-ops/mock-data": ["packages/mock-data/src"],
      "@sea-ops/workers": ["packages/workers/src"],
      "@sea-ops/simulated-server": ["packages/simulated-server/src"],
      "@sea-ops/agents": ["packages/agents/src"],
      "@sea-ops/tools": ["packages/tools/src"],
      "@sea-ops/core": ["packages/core/src"]
    }
  }
}
